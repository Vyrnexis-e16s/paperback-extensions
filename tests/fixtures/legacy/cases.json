{
  "description": "Controlled legacy-library fixtures. None of these operations delete records.",
  "cases": [
    {
      "id": "unchanged-id",
      "previousExtensionId": "MangaDex",
      "currentExtensionId": "MangaDex",
      "titleId": "32d76d19-8aeb-4d1c-9ca2-0d1e2c4a7b00",
      "expect": "preserve"
    },
    {
      "id": "changed-domain",
      "previousExtensionId": "HiveToons",
      "currentExtensionId": "HiveToons",
      "previousSourceDomain": "https://old.example.invalid",
      "currentCanonicalDomain": "https://hivetoons.org",
      "expect": "map-if-verified"
    },
    {
      "id": "changed-slug",
      "previousExtensionId": "WeebCentral",
      "titleId": "old-slug",
      "currentTitleUrl": "https://weebcentral.com/series/new-slug",
      "expect": "map-if-verified"
    },
    {
      "id": "removed-source",
      "previousExtensionId": "DiscontinuedSource",
      "currentExtensionId": null,
      "expect": "preserve-record-document-limitation"
    },
    {
      "id": "similar-name-collision",
      "leftTitle": "Solo Leveling",
      "rightTitle": "Solo Leveling",
      "sameId": false,
      "expect": "do-not-merge"
    },
    {
      "id": "missing-cover",
      "titleId": "missing-cover-title",
      "expect": "refresh-metadata-if-source-available"
    },
    {
      "id": "missing-chapter",
      "chapterId": "deleted-chapter",
      "expect": "surface-content-removed"
    },
    {
      "id": "temporarily-unreachable",
      "websiteStatus": "timeout",
      "expect": "retryable-error"
    },
    {
      "id": "permanently-discontinued",
      "websiteStatus": "gone",
      "expect": "preserve-record-document-limitation"
    },
    {
      "id": "download-dead-remote",
      "hasLocalDownload": true,
      "remoteAvailable": false,
      "expect": "do-not-delete-download"
    }
  ]
}
